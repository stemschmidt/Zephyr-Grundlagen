    "version": "0.2.0",
    "showDevDebugOutput": true,
    "configurations": [
        {
            "name": "Debug Hello World",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "external",
            "gdbTarget": "localhost:2331",
            "svdFile": "modules/hal/nordic/nrfx/bsp/stable/mdk/nrf54l15_application.svd",
            "cwd": "${workspaceFolder}",
            "executable": "examples/hello-world/build/merged.hex",
            "interface": "swd",
            "device": "nRF54L15_M33",
            "overrideLaunchCommands": [
                "monitor reset 0",
                "-target-download",
                "monitor reset 0"
            ],
            "overrideResetCommands": [
                "monitor reset 0"
            ],
            "postLaunchCommands": [
                "file examples/hello-world/build/hello-world/zephyr/zephyr.elf"
            ],
            "rtos": "Zephyr",
            "showDevDebugOutput": "none",
            "runToEntryPoint": "main"
        },
