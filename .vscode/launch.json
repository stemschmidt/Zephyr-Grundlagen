            "name": "Debug native-sim",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/examples/hello-world/build/hello-world/zephyr/zephyr.exe",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
