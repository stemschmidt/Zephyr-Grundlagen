{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "showDevDebugOutput": true,
    "configurations": [
        {
            "name": "Debug Mutex",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "external",
            "gdbTarget": "127.0.0.1:2331",
            "svdFile": "modules/hal/nordic/nrfx/bsp/stable/mdk/nrf54l15_application.svd",
            "cwd": "${workspaceFolder}",
            "executable": "kernel/mutex/build/merged.hex",
            "interface": "swd",
            "device": "nRF54L15_M33",
            "overrideLaunchCommands": [
                "monitor reset 0",
                "-target-download",
                "monitor reset 0"
            ],
            "overrideResetCommands": [
                "monitor reset 0"
            ],
            "postLaunchCommands": [
                "file kernel/mutex/build/mutex/zephyr/zephyr.elf"
            ],
            "rtos": "Zephyr",
            "showDevDebugOutput": "none",
            "runToEntryPoint": "main"
        },
        {
            "name": "Debug peripheral lbs",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "external",
            "gdbTarget": "host.docker.internal:2331",
            "svdFile": "modules/hal/nordic/nrfx/bsp/stable/mdk/nrf54l15_application.svd",
            "cwd": "${workspaceFolder}",
            "executable": "nrf/samples/bluetooth/peripheral_lbs/build/merged.hex",
            "interface": "swd",
            "device": "nRF54L15_M33",
            "overrideLaunchCommands": [
                "monitor reset 0",
                "-target-download",
                "monitor reset 0"
            ],
            "overrideResetCommands": [
                "monitor reset 0"
            ],
            "postLaunchCommands": [
                "file nrf/samples/bluetooth/peripheral_lbs/build/peripheral_lbs/zephyr/zephyr.elf"
            ],
            "rtos": "Zephyr",
            "showDevDebugOutput": "none",
            "runToEntryPoint": "main"
        }
    ]
}